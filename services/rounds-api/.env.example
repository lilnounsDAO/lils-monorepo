DATABASE_URL=postgresql://user:password@localhost:5432/nouns_indexer
# Mainnet RPC for signature checks (ERC-1271 wallets), vote lookups and the
# snapshot block each round pins when voting opens.
RPC_URL=https://edge.goldsky.com/standard/evm/1?secret=your-secret
PORT=3040
CHAIN_ID=1

# The house that owns the rounds.
HOUSE_HANDLE=lilnouns
HOUSE_NAME=Lil Nouns
HOUSE_TREASURY=0x0e5F9F7Ac5a86d7d5cCeD82bdbD18Bb0BBd53624
# Wallets that may open rounds without holding votes, comma separated.
HOUSE_ADMINS=

# Optional
# TOKEN_ADDRESS=0x4b10701Bfd7BFEdc47d50562b76b436fbB5BdB3B
# MIN_CREATE_VOTES=1
# SIGNATURE_TTL_MS=600000
# TICK_MS=30000
# ALLOWED_ORIGINS=https://lilnouns.wtf

# Import only: a token lifts the GitHub rate limit when listing the nouns.gg export.
# GITHUB_TOKEN=
# Imported images are served by this service at /images/<cid>, which fetches a
# CID once and then keeps it. PUBLIC_URL is where a browser reaches the service.
PUBLIC_URL=https://db.lilnouns.wtf/api/funding
# Where to look for a CID the cache does not have yet, in order.
# IMAGE_GATEWAYS=https://ipfs.io,https://dweb.link,https://gateway.pinata.cloud
# Serve images straight from a gateway instead of caching them here.
# IPFS_GATEWAY=https://ipfs.io
# Also pin every imported CID to our own kubo node.
# IPFS_API=http://127.0.0.1:5001
